# rmu-api-users: local development outside Docker (`npm run start:dev`). Copy to .env.
# Requires the infrastructure started from rmu-platform (`make up-infra`). From the host:
# Mongo localhost:27017, Keycloak http://localhost:8090, Kafka localhost:9093. Port 9092 is the
# in-network listener and advertises rmu-kafka-broker, which the host cannot resolve.

# --- Server ---------------------------------------------------------------------------------------
PORT=3010

# --- MongoDB --------------------------------------------------------------------------------------
RMU_MONGO_USERS_URI=mongodb://admin:admin@localhost:27017/rmu-users?authSource=admin

# --- Keycloak -------------------------------------------------------------------------------------
RMU_IAM_JWK_URI=http://localhost:8090/realms/rmu/protocol/openid-connect/certs
RMU_IAM_TOKEN_URI=http://localhost:8090/realms/rmu/protocol/openid-connect/token
RMU_IAM_ADMIN_URI=http://localhost:8090/admin/realms/rmu
RMU_IAM_CLIENT_ID=rmu-client
RMU_IAM_CLIENT_SECRET=changeit

# --- Kafka ----------------------------------------------------------------------------------------
RMU_KAFKA_BROKERS=localhost:9093
RMU_KAFKA_CLIENT_ID=rmu-api-users
RMU_KAFKA_CONSUMER_GROUP_ID=rmu-api-users-consumer
RMU_KAFKA_DEFAULT_PARTITIONS=1

# --- Users ----------------------------------------------------------------------------------------
# Length of the generated activation codes (default 8).
# RMU_USERS_ACTIVATION_CODE_SIZE=8
