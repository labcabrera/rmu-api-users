# rmu-api-users: container on the rmu-platform Docker network (`make docker-run`). Copy to .env.docker.
# Requires the infrastructure started from rmu-platform (network rmu-network), so the hosts are the
# container names. In the full Compose stack (profile apis) rmu-platform/compose/apis.yaml injects
# these values and this file is not used.

# --- Server ---------------------------------------------------------------------------------------
PORT=3010

# --- MongoDB --------------------------------------------------------------------------------------
RMU_MONGO_USERS_URI=mongodb://admin:admin@rmu-mongo:27017/rmu-users?authSource=admin

# --- Keycloak -------------------------------------------------------------------------------------
RMU_IAM_JWK_URI=http://rmu-keycloak:8080/sso/realms/rmu/protocol/openid-connect/certs
RMU_IAM_ISSUER_URI=http://localhost/sso/realms/rmu
RMU_IAM_AUDIENCE=rmu-api
RMU_IAM_TOKEN_URI=http://rmu-keycloak:8080/sso/realms/rmu/protocol/openid-connect/token
RMU_IAM_ADMIN_URI=http://rmu-keycloak:8080/sso/admin/realms/rmu
RMU_IAM_CLIENT_ID=rmu-client
RMU_IAM_CLIENT_SECRET=changeit

# --- Kafka ----------------------------------------------------------------------------------------
RMU_KAFKA_BROKERS=rmu-kafka-broker:9092
RMU_KAFKA_CLIENT_ID=rmu-api-users
RMU_KAFKA_DEFAULT_PARTITIONS=1

# --- Users ----------------------------------------------------------------------------------------
# Length of the generated activation codes (default 8).
# RMU_USERS_ACTIVATION_CODE_SIZE=8

# Timeout in ms of the calls to Keycloak (token and admin API); after it the request answers 504 (default 10000).
RMU_HTTP_TIMEOUT_MS=10000

# --- HTTP (optional) --------------------------------------------------------------------------------
# No origins: CORS stays off. RMU_THROTTLE_LIMIT=0 turns the request limit off.
RMU_CORS_ORIGINS=
RMU_THROTTLE_LIMIT=300
RMU_THROTTLE_TTL_MS=60000
RMU_TRUST_PROXY=loopback, linklocal, uniquelocal
